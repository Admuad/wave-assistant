# PostgreSQL Connection URL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server Port
PORT=8080
NODE_ENV=development

# DripWave Session Cookie (containing wave_refresh_token for 24/7 auto-renew)
DRIPS_AUTH_TOKEN="wave_refresh_token=...; wave_access_token=..."

# AI Provider Keys (Optional)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Telegram Alerts (Optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
